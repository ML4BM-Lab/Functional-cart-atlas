# syntax=docker/dockerfile:1

# Margaret Python environment
# Original host: Python 3.8.10; Milo also needs R/edgeR through rpy2.
FROM rocker/r-ver:4.1.3 AS marg-python-builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    RENV_CONFIG_CACHE_SYMLINKS=FALSE \
    RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
    RENV_CONFIG_PAK_ENABLED=FALSE \
    TZ=Etc/UTC

# Compilers and headers remain confined to this stage. R 4.1.3 matches the
# recovered Margaret R environment and builds the small edgeR bridge for Milo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        build-essential \
        git \
        ca-certificates \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/functional-cart-atlas

COPY environments/marg/Docker/renv.python-bridge.lock /opt/functional-cart-atlas/renv.lock

RUN R -q -e "install.packages('https://cloud.r-project.org/src/contrib/renv_1.2.3.tar.gz', repos = NULL, type = 'source')" \
    && R -q -e "renv::restore(lockfile = '/opt/functional-cart-atlas/renv.lock', library = '/usr/local/lib/R/site-library', prompt = FALSE)"

# rpy2 links against the Rocker R build. These development symlinks are needed
# only while compiling its API extension and are not copied to the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpcre2-dev \
        liblzma-dev \
        libbz2-dev \
        libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 --version | grep -q '^Python 3\.8\.10$' \
    && python3 -m venv /opt/marg-python \
    && /opt/marg-python/bin/python -m pip install --no-cache-dir \
        pip==23.3.2 \
        setuptools==68.2.2 \
        wheel==0.41.3

COPY environments/marg/Docker/requirements.runtime.txt /tmp/requirements.txt

# Exact recovered versions are installed without dependency re-resolution.
# Old jaxlib wheels are retained by the project's official wheel archive.
RUN /opt/marg-python/bin/python -m pip install --no-cache-dir --no-deps \
        --find-links https://storage.googleapis.com/jax-releases/jax_releases.html \
        -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt


FROM rocker/r-ver:4.1.3

LABEL org.opencontainers.image.title="Functional CAR-T Atlas - Python (marg)" \
      org.opencontainers.image.description="Python runtime for Functional CAR-T Atlas scripts executed on Margaret" \
      org.opencontainers.image.version="0.2.0"

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/marg-python/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RENV_CONFIG_AUTOLOADER_ENABLED=FALSE \
    RPY2_CFFI_MODE=API \
    TZ=Etc/UTC

# Runtime-only libraries. CUDA user-space libraries are supplied by the pinned
# Python distributions; the host driver remains external to the container.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-distutils \
        ca-certificates \
        libffi7 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=marg-python-builder /opt/marg-python /opt/marg-python
COPY --from=marg-python-builder /usr/local/lib/R/site-library /usr/local/lib/R/site-library

WORKDIR /workspace

CMD ["bash"]
